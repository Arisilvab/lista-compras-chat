<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <title>Assistente de Compras Saudáveis</title>
  <style>
    body { font-family: Arial; background: #f6f6f6; padding: 20px; }
    #chat { max-width: 600px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .msg { margin: 10px 0; }
    .user { font-weight: bold; color: #333; }
    .bot { background: #eef; padding: 10px; border-radius: 5px; }
  </style>
</head>
<body>
  <div id="chat">
    <h2>Chat - Lista de Compras Saudáveis 🛒</h2>
    <div id="messages"></div>
    <input type="text" id="input" placeholder="Digite sua cidade, estado e orçamento..." style="width: 100%; padding: 10px;" />
  </div>

  <script>
    const input = document.getElementById('input');
    const openai_api_key = process.env.OPENAI_API_KEY; // 🔁 substitua por sua chave real

    input.addEventListener('keydown', async (e) => {
      if (e.key === 'Enter') {
        const userMsg = input.value;
        appendMessage('user', userMsg);
        input.value = '';

        const prompt = `Extraia cidade, estado e orçamento do seguinte texto e retorne um JSON com essas chaves: cidade, estado, orcamento. Texto: ${userMsg}`;

        const response = await fetch("https://api.openai.com/v1/chat/completions", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${openai_api_key}`
          },
          body: JSON.stringify({
            model: "gpt-3.5-turbo",
            messages: [{ role: "user", content: prompt }]
          })
        });

        const data = await response.json();
        const content = data.choices[0].message.content;

        try {
          const { cidade, estado, orcamento } = JSON.parse(content);
          const listaResponse = await fetch("https://lista-compras-vtxx.onrender.com/gerar-lista", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ cidade, estado, orcamento })
          });

          const lista = await listaResponse.json();
          const produtos = lista.lista.map(p => `- ${p.produto}: R$${p.preco.toFixed(2)}`).join('<br>');
          appendMessage('bot', `Aqui está sua lista de compras:<br>${produtos}<br><br>Total: R$${lista.total.toFixed(2)}`);
        } catch (err) {
          appendMessage('bot', `Desculpe, não entendi. Pode repetir com cidade, estado e orçamento?`);
        }
      }
    });

    function appendMessage(sender, text) {
      const msg = document.createElement('div');
      msg.className = `msg ${sender}`;
      msg.innerHTML = `<div class="${sender}">${text}</div>`;
      messages.appendChild(msg);
    }
  </script>
</body>
</html>
